<?xml version="1.0" encoding="utf-8"?>
<com.zerobranch.layout.SwipeLayout
android:id="@+id/Swipe_Layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:draggedItem="@id/invoice_builder"
    app:rightItem="@id/delet_item"
    app:swipeDirection="left"
    app:isEnabledSwipe="true"
    app:isTogether="true"
    app:isFreeDragAfterOpen="false"
    android:background="@color/transparent"
    android:layout_marginVertical="16dp"
android:layout_marginHorizontal="32dp"
    >
    <ImageView
        android:id="@+id/delet_item"
        android:layout_width="90dp"
        android:layout_height="match_parent"
        android:src="@drawable/baseline_delete_24"
        android:layout_gravity="end"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@color/transparent"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/invoice_builder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?attr/colorPrimary"
        app:cardCornerRadius="32dp"
        android:layout_gravity="center"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:layout_gravity="center"
            >

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/purchasedItems_RV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/purchased_item_builder"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                />
            <View
                android:layout_marginVertical="16dp"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black_light"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_gravity="bottom"
                >
                <TextView
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/total_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/CustomTextStyle"
                    android:text="@string/total"
                    android:textColor="@color/black_light"
                    android:layout_weight="1"
                    android:textAlignment="textStart"
                    />
                <TextView
                    android:textAlignment="textStart"
                    android:layout_weight="1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/total_Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/CustomTextStyle"
                    tools:text="1500 "
                    android:textColor="@color/black_light"/>
            </LinearLayout>

            <TextView
                android:paddingTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/CustomTextStyle"
                tools:text="@tools:sample/date/mmddyy"
                android:textColor="@color/black_light"
                android:layout_weight="1"
                android:textAlignment="textStart"
                />

        </LinearLayout>



    </com.google.android.material.card.MaterialCardView>
</com.zerobranch.layout.SwipeLayout>
